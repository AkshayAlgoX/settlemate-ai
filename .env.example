# =========================================================================
# SettleMate AI — Production Environment Configuration (.env.production)
# =========================================================================

# Server Runtime Environment
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Session & JWT Cryptographic Signing Secret (Generate with: openssl rand -hex 32)
# REQUIRED: Must be at least 32 characters in production.
AUTH_SECRET=

# Persistent SQLite Database Locations (Unified under persistent volume /app/data)
DATABASE_URL="file:/app/data/dev.db"
SETTLEMATE_DB_PATH="/app/data/settlemate.db"

# Webhook Cryptographic Signing (src/lib/webhooks/webhook-secrets.ts)
# Required in production. Generate with: openssl rand -hex 32 (at least 32 bytes).
# Unset outside production = random per-process value. Old repository defaults are rejected.
WEBHOOK_SECRET=
WEBHOOK_SHARED_SECRET=
# AES-256-GCM key for webhook secrets at rest: exactly 64 hex characters (openssl rand -hex 32).
WEBHOOK_ENCRYPTION_KEY=

# Prometheus & Telemetry Scrape Token (Optional)
METRICS_TOKEN=

# Advisory AI Model Integrations (Optional — system automatically falls back to offline deterministic solver if empty)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional S3/R2 Remote Backup Replication (for scripts/backup.ts)
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
