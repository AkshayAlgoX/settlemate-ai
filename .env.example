# =========================================================================
# SettleMate AI — Environment Configuration Example
# =========================================================================

# --- AI LLM Providers (Optional - falls back to deterministic engine if unset) ---
# Provide at least one API key to enable live LLM AI Investigator reasoning.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude Configuration (Alternative LLM provider)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini Configuration (Alternative LLM provider)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# --- Persistent Storage & Database ---
# SQLite Database file location (defaults to data/settlemate.db)
SETTLEMATE_DB_PATH=data/settlemate.db
DATABASE_URL="file:./dev.db"

# --- Webhook Security & Dispatch ---
# Shared secret for signing dispatched webhooks with HMAC-SHA256
WEBHOOK_SECRET=whsec_settlemate_live_signing_key_001
WEBHOOK_SHARED_SECRET=whsec_settlemate_live_signing_key_001

# --- Server Configuration ---
PORT=3000
NODE_ENV=development

# --- Session & Security ---
AUTH_SECRET=settlemate_production_jwt_session_secret_key_889977
