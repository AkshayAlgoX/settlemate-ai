                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactions\": [\n    {\n      \"source\": \"PAYMENT\",\n      \"amountPaise\": 20000,\n      \"currency\": \"INR\",\n      \"date\": \"2026-08-20\",\n      \"referenceId\": \"TXN_8821\"\n    },\n    {\n      \"source\": \"SETTLEMENT\",\n      \"amountPaise\": 18450,\n      \"currency\": \"INR\",\n      \"date\": \"2026-08-21\",\n      \"referenceId\": \"TXN_8821\"\n    },\n    {\n      \"source\": \"REFUND\",\n      \"amountPaise\": 1550,\n      \"currency\": \"INR\",\n      \"date\": \"2026-08-21\",\n      \"referenceId\": \"TXN_8821\"\n    }\n  ],\n  \"sync\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/reconcile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reconcile"]
            }
          }
        },
        {
