generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}
model Batch {
  id              String    @id @default(cuid())
  name            String
  size            Int
  status          String    @default("CREATED")
  source          String    @default("GENERATED")
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  totalRecords      Int?
  autoMatched       Int?
  exceptionsFound   Int?
  unresolvedCount   Int?
  accuracy          Float?
  precision         Float?
  recall            Float?
  throughputRps     Float?
  processingTimeMs  Int?
  pass1Accuracy     Float?
  pass2Accuracy     Float?
  pass3Accuracy     Float?
  adversarialScore  Float?
  // Sum of exception amounts in paise. BigInt to stay type-identical to
  // schema.postgresql.prisma, where INT32 overflowed above ₹2.14 crore.
  amountAtRisk      BigInt?

  orders            Order[]
  payments          Payment[]
  settlements       Settlement[]
  bankTransactions  BankTransaction[]
  refunds           Refund[]
  chargebacks       Chargeback[]
  reconResults      ReconciliationResult[]
  cardinalityLinks  CardinalityLink[]
  exceptions        Exception[]
  auditLogs         AuditLog[]
  chatMessages      ChatMessage[]
  groundTruths      GroundTruth[]
  agentTraces       AgentTrace[]
  feedbackEntries   FeedbackEntry[]
  ledgerEntries     ReconciliationLedger[]
  auditEvents       AuditEvent[]
  runMetadata       RunMetadata[]
  scaleRuns         ScaleRun[]
}

model Order {
  id            String   @id @default(cuid())
  batchId       String
  batch         Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  orderId       String
  amount        Int
  currency      String   @default("INR")
  status        String
  customerEmail String?
  description   String?
  createdAt     DateTime

  @@index([batchId])
  @@index([orderId])
}

model Payment {
  id          String    @id @default(cuid())
  batchId     String
  batch       Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  paymentId   String
  orderId     String
  amount      Int
  currency    String    @default("INR")
  status      String
  method      String
  fee         Int       @default(0)
  tax         Int       @default(0)
  capturedAt  DateTime?
  createdAt   DateTime

  @@index([batchId])
  @@index([paymentId])
  @@index([orderId])
}

model Settlement {
  id            String    @id @default(cuid())
  batchId       String
  batch         Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  settlementId  String
  paymentId     String
  amount        Int
  fee           Int       @default(0)
  tax           Int       @default(0)
  utr           String?
  status        String
  settledAt     DateTime?
  createdAt     DateTime

  @@index([batchId])
  @@index([settlementId])
  @@index([paymentId])
  @@index([utr])
}

model BankTransaction {
  id        String    @id @default(cuid())
  batchId   String
  batch     Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  txnId     String
  utr       String?
  amount    Int
  type      String
  narration String?
  balance   BigInt?
  txnDate   DateTime
  valueDate DateTime?

  @@index([batchId])
  @@index([utr])
  @@index([txnId])
}

model Refund {
  id          String    @id @default(cuid())
  batchId     String
  batch       Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  refundId    String
  paymentId   String
  amount      Int
  status      String
  reason      String?
  createdAt   DateTime
  processedAt DateTime?

  @@index([batchId])
  @@index([paymentId])
  @@index([refundId])
}

model Chargeback {
  id            String    @id @default(cuid())
  batchId       String
  batch         Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  chargebackId  String
  paymentId     String
  amount        Int
  reason        String?
  status        String
  createdAt     DateTime
  resolvedAt    DateTime?

  @@index([batchId])
  @@index([paymentId])
  @@index([chargebackId])
}

model ReconciliationResult {
  id                  String   @id @default(cuid())
  batchId             String
  batch               Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  paymentId           String
  orderId             String
  settlementId        String?
  bankTxnId           String?
  refundIds           String?
  chargebackIds       String?
  orderAmount         Int
  paymentAmount       Int
  paymentFee          Int
  paymentTax          Int
  refundAmount        Int      @default(0)
  chargebackAmount    Int      @default(0)
  expectedNetAmount   Int
  actualSettledAmount Int?
  bankCreditedAmount  Int?
  mismatchAmount      Int?
  status              String
  confidenceScore     Int
  matchMethod         String?
  matchDetails        String?
    cardinalityType    String    @default("1:1")
  cardinalityReason  String?
  relationshipScore  Int?
  passNumber          Int      @default(1)
  createdAt           DateTime @default(now())

  @@index([batchId])
  @@index([paymentId])
  @@index([status])
}

model Exception {
  id              String    @id @default(cuid())
  batchId         String
  batch           Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  reconResultId   String?
  exceptionType   String
  paymentId       String?
  orderId         String?
  settlementId    String?
  bankTxnId       String?
  utr             String?
  amount          Int
  mismatchAmount  Int?
  confidenceScore Int
  riskLevel       String    @default("MEDIUM")
  status          String    @default("OPEN")
  suggestedAction String?
  resolution      String?
  resolvedBy      String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  aiExplanation   AiExplanation?
  agentTraces     AgentTrace[]

  @@index([batchId])
  @@index([exceptionType])
  @@index([status])
}

model AiExplanation {
  id                String    @id @default(cuid())
  exceptionId       String    @unique
  exception         Exception @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  summary           String
  reason            String
  evidence          String
  recommendedAction String
  riskLevel         String
  needsManualReview Boolean
  model             String
  tokensUsed        Int?
  latencyMs         Int?
  createdAt         DateTime  @default(now())
}

model GroundTruth {
  id            String @id @default(cuid())
  batchId       String
  batch         Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  paymentId     String
  expectedLabel String
  scenario      String

  @@index([batchId])
  @@index([paymentId])
}

model AgentTrace {
  id            String    @id @default(cuid())
  batchId       String
  batch         Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  exceptionId   String?
  exception     Exception? @relation(fields: [exceptionId], references: [id], onDelete: SetNull)
  agentName     String
  passNumber    Int
  stepNumber    Int
  stepLabel     String
  stepDetail    String
  input         String?
  output        String?
  confidenceBefore Int?
  confidenceAfter  Int?
  createdAt     DateTime  @default(now())

  @@index([batchId])
  @@index([exceptionId])
}

model AuditLog {
  id          String    @id @default(cuid())
  batchId     String?
  batch       Batch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  timestamp   DateTime  @default(now())
  actor       String
  action      String
  entityType  String?
  entityId    String?
  beforeState String?
  afterState  String?
  reason      String?
  metadata    String?

  @@index([batchId])
  @@index([timestamp])
}

model ChatMessage {
  id         String   @id @default(cuid())
  batchId    String
  batch      Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  role       String
  content    String
  evidence   String?
  model      String?
  tokensUsed Int?
  latencyMs  Int?
  createdAt  DateTime @default(now())

  @@index([batchId])
}

model FeedbackEntry {
  id                String   @id @default(cuid())
  batchId           String
  batch             Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  exceptionId       String?
  originalStatus    String
  newStatus         String
  confidenceBefore  Int
  confidenceAfter   Int
  adjustedFactor    String?
  adjustedDelta     Int?
  createdAt         DateTime @default(now())

  @@index([batchId])
}

// One-row-per-batch concurrency guard for the multi-pass reconciliation POST.
// batchId is unique so at most one process can hold the lock for a batch at a
// time; the holder is the only one allowed to run the (expensive) 3-pass
// workflow. A stale lock older than STALE_MS is reclaimable after a crash.
model ReconciliationLock {
  id        String   @id @default(cuid())
  batchId   String   @unique
  token     String
  lockedAt  DateTime @default(now())
}

model CardinalityLink {
  id                String   @id @default(cuid())
  batchId           String
  batch             Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  relationshipType  String
  sourceType        String
  sourceIds         String
  targetType        String
  targetIds         String

  amount            Int
  differencePaise   Int      @default(0)
  confidenceScore   Int
  reasonCode        String
  matchMethod       String?

  runId             String?
  createdAt         DateTime @default(now())

  @@index([batchId])
  @@index([relationshipType])
  @@index([sourceType])
  @@index([targetType])
}

// One row per reconciled payment — the finalized financial state, tracing back to the
// batch/run, the decision, the source records, and the gross/fee/tax/refund/chargeback/net
// breakdown. `status` holds ACTIVE | SUPERSEDED so a re-run keeps version history instead of
// deleting the prior finalized state; `version` increments each run; `approvalState` records
// how the batch was routed (APPROVED straight-through / PENDING_REVIEW / PENDING_APPROVAL).
model ReconciliationLedger {
  id                 String   @id @default(cuid())
  batchId            String
  batch              Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  paymentId          String
  orderId            String
  runId              String?
  version            Int      @default(1)
  status             String   @default("ACTIVE")
  outcome            String
  riskLevel          String
  reasonCode         String
  matchStrategy      String
  approvalState      String
  sourceRecordIds    String
  grossPaise         Int
  feePaise           Int
  taxPaise           Int
  refundPaise        Int
  chargebackPaise    Int
  netPaise           Int
  currency           String   @default("INR")
  expectedNetPaise   Int
  actualSettledPaise Int?
  bankCreditedPaise  Int?
  mismatchPaise      Int?
  createdAt          DateTime @default(now())

  @@index([batchId])
  @@index([paymentId])
  @@index([status])
}

// Append-only, per-batch tamper-evident lineage. Each event links to the previous one via
// the hash chain: currentHash = sha256(previousHash + canonicalPayload). The first event in a
// batch chains off GENESIS_HASH. seq is consecutive per batch (enforced by @@unique). This
// makes row alteration, deletion, or reordering detectable by verifyAuditChain — tamper-EVIDENT,
// not cryptographically immutable.
model AuditEvent {
  id               String   @id @default(cuid())
  batchId          String
  batch            Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  seq              Int
  eventType        String
  actor            String
  entityId         String?
  occurredAt       DateTime @default(now())
  canonicalPayload String
  previousHash     String
  currentHash      String

  @@unique([batchId, seq])
  @@index([batchId])
}

// One row per reconciliation run — captures what versions executed and on what input, so a run can
// be reproduced and audited. inputFingerprint is a deterministic hash of the actual normalized input;
// outcomeFingerprint is a deterministic hash of the reconciliation outcome (excluding timing). Replay
// identity = (inputFingerprint, version set): same input + same versions ⇒ same outcome. A changed
// version on a stored row means the run is no longer reproducible against the current pipeline.
model RunMetadata {
  id                      String   @id @default(cuid())
  runId                   String   @unique
  batchId                 String
  batch                   Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  inputFingerprint        String
  outcomeFingerprint      String?
  providerSchemaVersion   String
  normalizerVersion       String
  matcherVersion          String
  cardinalityVersion      String
  rulesetVersion          String
  policyVersion           String
  modelVersion            String
  engineVersion           String
  outcomeStatus           String?
  createdAt               DateTime @default(now())

  @@index([batchId])
  @@index([inputFingerprint])
}

// Durable / resumable execution of the scalable cardinality path. One ScaleRun per reconciliation
// run; one ScalePartition per deterministic candidate cluster. Statuses are stored as strings so the
// state machine can evolve without migrations. idempotencyKey is unique so re-executing an already
// COMPLETED partition is a no-op (safe duplicate retry — never double-counts or double-writes).
model ScaleRun {
  id                 String   @id @default(cuid())
  batchId            String
  batch              Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  runId              String
  idempotencyKey     String   @unique // hash(runId + pipelineVersion) — one durable run per reconciliation run
  status             String   @default("RUNNING") // RUNNING | COMPLETED | FAILED | DEAD_LETTER
  attempt            Int      @default(0)
  retryCount         Int      @default(0)
  progressPct        Int      @default(0)
  totalPartitions    Int      @default(0)
  completedPartitions Int     @default(0)
  checkpoint         String? // JSON: completed partitionIds + per-partition result refs, for resume
  lastError          String?
  nextRetryAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  partitions         ScalePartition[]

  @@index([batchId])
  @@index([status])
}

model ScalePartition {
  id             String   @id @default(cuid())
  scaleRunId     String
  scaleRun       ScaleRun @relation(fields: [scaleRunId], references: [id], onDelete: Cascade)
  partitionId    String
  bucketKey      String
  status         String   @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED | DEAD_LETTER
  attempt        Int      @default(0)
  retryCount     Int      @default(0)
  idempotencyKey String   @unique // hash(runId + partitionId + attempt)
  matchedCount   Int      @default(0)
  lastError      String?
  nextRetryAt    DateTime?
  checkpoint     String? // JSON progress, for resume
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([scaleRunId, partitionId])
  @@index([status])
}